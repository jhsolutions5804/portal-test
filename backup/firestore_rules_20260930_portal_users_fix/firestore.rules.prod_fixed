rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isApproved() {
      return request.auth != null
        && request.auth.token.email.matches('.*@jhsol[.]kr$')
        && exists(/databases/$(database)/documents/portal_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.status == 'approved';
    }

    function isAdmin() {
      return isApproved()
        && get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.admin == true;
    }

    // 관리자 전용 컬렉션 (연명부 민감정보·사진, 팀 단가·일당) — 아래 catch-all(승인 계정 전체 허용)에서 반드시 제외해야 한다.
    // Firestore 규칙은 일치하는 match 중 하나라도 허용하면 허용(OR)이므로, 개별 match만으로는 제한되지 않는다.
    function isAdminOnlyCollection() {
      return request.path[3] in ['master_worker_private','master_worker_photos','portal_users'];
    }

    // portal_users: 직원 계정 문서.
    //  · 읽기: 승인된 직원은 직원 목록(조직도·결재선 등)을 위해 조회 가능, 본인 문서는 로그인 승인 체크를 위해 항상 조회 가능
    //  · 쓰기: 관리자만. 단, 직원 본인은 아래 5개 필드만 수정 가능(비밀번호 변경·연락처·휴대폰 인증 표시·일지 조회 대상).
    //    admin·perms·status·teamLeaderIds 등 권한 관련 필드는 관리자만 바꿀 수 있다.
    //  ※ 이 컬렉션은 아래 포괄 규칙(/{document=**})에서 제외되어야 한다 — 제외하지 않으면 포괄 규칙이 승인된 직원 전원에게 읽기·쓰기를 다시 열어 준다(OR 평가).
    match /portal_users/{uid} {
      allow read: if isApproved() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
      allow update: if isApproved() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['_pw','phone','phoneVerified','phoneVerifiedAt','dailyViewTargets']);
      // 최초 관리자 계정 부트스트랩: 본인 문서가 아직 없을 때만, 지정된 관리자 이메일 본인 문서 생성 허용
      allow write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email == 'jh.kim@jhsol.kr'
        && !exists(/databases/$(database)/documents/portal_users/$(uid));
    }

    // ══════════════════════════════════════════════════════════════════
    // 원격 서명 · 문서 확인 링크 (sign.html — 로그인 없이 접속, 휴대폰 문자 인증(OTP)으로 본인 확인)
    //  · sign_links/{token}        : 토큰(20자 무작위 ID)을 아는 사람만 개별 조회(get). 목록 조회·생성·삭제는 관리자만.
    //                                공개 필드는 최소한(문서 종류·이름·인증 대상 번호·만료·상태)만 둔다.
    //  · sign_links/{token}/secure : 문서 내용(주민번호 마스킹본)·회사 도장·서명 결과. 링크에 지정된 번호로 OTP 인증을 통과한 사용자만 읽기 가능.
    //                                서명 결과(result)는 1회 생성만 가능하고, 서명자는 그 외 어떤 문서도 쓸 수 없다.
    //  · 서명자(전화 인증 계정)는 이메일이 없어 isApproved()가 거짓이므로 위 링크 외의 모든 컬렉션에 접근할 수 없다.
    // ══════════════════════════════════════════════════════════════════
    function hasPhoneAuth() {
      return request.auth != null && ('phone_number' in request.auth.token);
    }
    function linkIsOpen(l) {
      return l.get('status', '') != 'revoked'
        && l.get('expiresTs', null) != null
        && request.time < l.expiresTs;
    }
    function isLinkSigner(token) {
      let l = get(/databases/$(database)/documents/sign_links/$(token)).data;
      return hasPhoneAuth()
        && l.get('phoneE164', '') != ''
        && request.auth.token.phone_number == l.phoneE164
        && linkIsOpen(l);
    }
    match /sign_links/{token} {
      allow get: if true;
      // 서명 완료 표시: 서명 결과(result) 생성과 같은 배치에서만, status/signedAt 두 필드만 변경 가능
      allow update: if hasPhoneAuth()
          && resource.data.get('phoneE164', '') != ''
          && request.auth.token.phone_number == resource.data.phoneE164
          && resource.data.status == 'pending'
          && resource.data.docType in ['labor', 'annual']
          && linkIsOpen(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signedAt'])
          && request.resource.data.status == 'signed'
          && request.resource.data.signedAt == request.time
          && existsAfter(/databases/$(database)/documents/sign_links/$(token)/secure/result);

      match /secure/{docId} {
        allow get: if isLinkSigner(token);
        allow create: if docId == 'result'
          && isLinkSigner(token)
          && get(/databases/$(database)/documents/sign_links/$(token)).data.status == 'pending'
          && get(/databases/$(database)/documents/sign_links/$(token)).data.docType in ['labor', 'annual']
          && request.resource.data.keys().hasOnly(['signData', 'signedAt', 'signedIp', 'signedUserAgent', 'remoteSigned'])
          && request.resource.data.keys().hasAll(['signData', 'signedAt', 'remoteSigned'])
          && request.resource.data.signData is string
          && request.resource.data.signData.size() < 400000
          && request.resource.data.signData.matches('data:image/png;base64,[A-Za-z0-9+/=]+')
          && request.resource.data.signedAt == request.time
          && request.resource.data.remoteSigned == true
          && request.resource.data.get('signedIp', '').size() < 64
          && request.resource.data.get('signedUserAgent', '').size() < 600;
      }
    }

    // 근로자 연명부 — 민감정보(주민번호·연락처·계좌·검진·포털 계정)·팀 단가·일당과 사진은 관리자만
    match /master_worker_private/{wid} {
      allow read, write: if isAdmin();
    }
    match /master_worker_photos/{wid} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 1000000
        && request.resource.data.dataUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+');
    }

    // 그 외 모든 컬렉션(현재+향후 전부, 관리자 전용 제외): 승인된 @jhsol.kr 계정만 읽기/쓰기
    match /{document=**} {
      allow read, write: if isApproved() && !isAdminOnlyCollection();
    }
  }
}