rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isApproved() {
      return request.auth != null
        && request.auth.token.email.matches('.*@jhsol[.]kr$')
        && exists(/databases/$(database)/documents/portal_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.status == 'approved';
    }
    function isAdmin() {
      return isApproved()
        && get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.admin == true;
    }
    // 실무자: PJT 권한(portal_users.perms.pjt)이 있는 승인 계정(GUEST 사번 제외) 또는 관리자 — 근로자 연명부를 등록·조회·수정한다
    function isRosterUser() {
      return isApproved() && !isGuestEmp()
        && (isAdmin() || get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.get('perms', {}).get('pjt', false) == true);
    }
    // 재무회계 권한(2026-10-08, 설계서 기획_재무제표_설계 §14): 관리자, 재무회계팀 소속(portal_users.dept == '재무회계팀'), 또는 perms.finance — GUEST 사번 제외
    function isFinanceUser() {
      return isApproved() && !isGuestEmp()
        && (isAdmin()
            || get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.get('dept', '') == '재무회계팀'
            || get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.get('perms', {}).get('finance', false) == true);
    }
    // edoc_* 컬렉션 여부 판별 (경로의 4번째 세그먼트 = 최상위 컬렉션명)
    function isEdocCollection() {
      return request.path[3] in
        ['edoc_daily','edoc_leave','edoc_resign','edoc_cert','edoc_purchase','edoc_expense','edoc_overtime','edoc_attend','edoc_drive'];
    }
    // 관리자 전용 컬렉션 (연명부 민감정보 · 사진) — 아래 catch-all(승인 계정 전체 허용)에서 반드시 제외해야 한다.
    // Firestore 규칙은 일치하는 match 중 하나라도 허용하면 허용(OR)이므로, 개별 match만으로는 제한되지 않는다.
    // ── GUEST 사번 계정 판별: 계정 문서(portal_users)의 사번(empNo)이 'guest'로 시작(대소문자 무시).
    //  · empNo는 관리자만 수정할 수 있다(직원 본인은 phone·phoneVerified·phoneVerifiedAt만 수정 가능) → GUEST가 사번을 바꿔 우회할 수 없다.
    //  · 사번이 없거나 문자열이 아니면 GUEST가 아닌 것으로 본다.
    function isGuestEmp() {
      return request.auth != null
        && exists(/databases/$(database)/documents/portal_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.get('empNo', '') is string
        && get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.get('empNo', '').lower().matches('guest.*');
    }
    // 일정 컬렉션: 최상위 3종 + 경량 PJT 하위(pjt_registry/{id}/schedules). 포괄 규칙에서 반드시 제외(제외하지 않으면 OR 평가로 GUEST 쓰기가 다시 열린다).
    function isScheduleCollection() {
      // ※ request.path[5] 는 경로가 짧은 문서(예: pjt_registry/{id}, 길이 5)에서는 존재하지 않아 오류가 된다 → 규칙 전체가 거부로 평가된다.
      //   그래서 인덱스 접근 없이 경로 문자열 패턴으로 판별한다(경량 PJT 하위의 schedules 컬렉션 문서).
      return request.path[3] in ['user_schedules','ph4_schedules','company_schedules']
        || (request.path[3] == 'pjt_registry' && request.path.size() == 7 && string(request.path).matches('.*/pjt_registry/[^/]+/schedules/[^/]+$'));
    }
    // 인사 캘린더 접근자 — hr_calendar_access/config 의 emails 목록(지정 담당자 4명)에 든 승인 계정만.
    //  · 목록은 소문자 이메일 배열. 화면 숨김과 별개로 이 규칙이 실제 데이터 접근을 막는다.
    function isHrCalendarUser() {
      return isApproved()
        && exists(/databases/$(database)/documents/hr_calendar_access/config)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/hr_calendar_access/config).data.get('emails', []);
    }
    function validHrEvent() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() < 201
        && d.type in ['interview','offerreply','salarynego','eval','resign','etc']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // ── 인사 데이터(계약서·급여·평가·면담·퇴직금 등) — 인사 모듈 전용 컬렉션은 관리자만 ──
    //  · 서브컬렉션(예: annual_contracts/{근로자}/contracts)까지 모두 포함(경로 4번째 세그먼트 기준).
    //  · 이전에는 아래 catch-all(승인된 직원 전체 허용)에 걸려 일반 직원도 개발자 도구로 읽고 쓸 수 있었다.
    //  · payslips 는 기획(gihoek) 급여 PJT 배분이 netPay 를 읽으므로, 기획 권한(perms.plan)자에게 읽기만 추가 허용한다.
    function isHrDataCollection() {
      return request.path[3] in ['annual_contracts','labor_contracts','overtime','company_settings','dismissal_notices','doc_send_log','evaluations','interviews','invoice_history','leave_promotions','payment_history','salary_offers','severance','recruit_applicants','payslips','general_leases','general_vehicles','general_assets','general_renewals','general_drive_history'];
    }
    function hasPlanPerm() {
      return isApproved()
        && get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.get('perms', {}).get('plan', false) == true;
    }
    // 채용 지원 폼(홈페이지 recruit.html)은 로그인 없이 지원서만 '새로 저장'한다.
    //  · 읽기·수정·삭제는 불가(관리자만 — 위 인사 데이터 잠금 규칙). 허용 항목·길이·상태·서버시각을 검증한다.
    //  · status 는 반드시 'new' (지원자가 합격·검토중으로 만들어 보낼 수 없음), createdAt 은 서버 시각(request.time)과 같아야 함.
    function validApplicantCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','birth','phone','gender','email','eduLevel','address','notes','educations','careers','certs','military','submittedAt','status','jobKey','jobTitle','createdAt'])
        && d.keys().hasAll(['name','phone','status','createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.status == 'new'
        && d.createdAt == request.time
        && (!('birth' in d) || (d.birth is string && d.birth.size() <= 30))
        && (!('gender' in d) || (d.gender is string && d.gender.size() <= 20))
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('eduLevel' in d) || (d.eduLevel is string && d.eduLevel.size() <= 50))
        && (!('address' in d) || (d.address is string && d.address.size() <= 300))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
        && (!('submittedAt' in d) || (d.submittedAt is string && d.submittedAt.size() <= 40))
        && (!('jobKey' in d) || (d.jobKey is string && d.jobKey.size() <= 100))
        && (!('jobTitle' in d) || (d.jobTitle is string && d.jobTitle.size() <= 100))
        && (!('educations' in d) || (d.educations is list && d.educations.size() <= 20))
        && (!('careers' in d) || (d.careers is list && d.careers.size() <= 30))
        && (!('certs' in d) || (d.certs is list && d.certs.size() <= 30))
        && (!('military' in d) || d.military is map);
    }
    // 근태 기록 소유자: 기록의 workerId 근로자 문서(workers)의 portalUid 가 로그인 계정이면 본인
    function isAttOwner(wid) {
      return isApproved() && wid is string
        && get(/databases/$(database)/documents/workers/$(wid)).data.get('portalUid', '') == request.auth.uid;
    }
    // 읽기는 승인 직원에게 열고 쓰기만 관리자로 제한하는 컬렉션(PJT 프로젝트 정보: 이름·현장·발주처·내용·품목·수량·시작일·종료 상태).
    //  ※ 포괄 규칙의 write 에서 제외해야 한다(제외하지 않으면 OR 평가로 일반 직원 쓰기가 다시 열린다).
    function isAdminWriteCollection() {
      return request.path[3] in ['pjt_settings','pjt_registry','edoc_settings'];
    }

    // 평가(eval_*) 컬렉션은 아래 전용 규칙만 적용한다 — 이 함수가 없으면 맨 아래 catch-all(승인된 직원이면 읽기·쓰기 허용)이 전용 규칙과 OR 로 합쳐져 모든 보호가 사라진다
    function isEvalCollection() {
      return request.path[3] in ['eval_cycles','eval_tasks','eval_submissions','eval_audit'];
    }
    function isAdminOnlyCollection() {
      return request.path[3] in ['ledger_entries','ledger_meta','ledger_audit','ledger_imports','ledger_receipts','worker_identity','access_log','access_counters','access_log_checks','master_worker_private','master_worker_photos','master_worker_info','team_rates','portal_users','portal_secrets','hr_calendar_access','hr_calendar_events','annual_contracts','labor_contracts','overtime','company_settings','dismissal_notices','doc_send_log','evaluations','interviews','invoice_history','leave_promotions','payment_history','salary_offers','severance','recruit_applicants','payslips','worker_private','workers','worker_attendance_log','job_postings','edoc_secrets','edoc_notifications','general_leases','general_vehicles','general_assets','general_renewals','general_drive_history'] || isScheduleCollection() || request.path[3].matches('gihoek_.*');
    }
    // 전자결재 문서 열람 가능 여부: 작성자 본인, 결재선/회람 대상자(viewerUids), 관리자, 최종 게시(posted)된 문서
    function canViewEdocDoc() {
      return isApproved() && (
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        resource.data.status == 'posted' ||
        (request.auth.uid in resource.data.get('viewerUids', []))
      );
    }


    // ── 전자결재 문서 쓰기(2026-10-04 전환) ──
    //  · 직원 화면은 '내 임시저장/반려 문서'만 만들고 고칠 수 있다. 상신·승인·반려·회수·게시·삭제는 서버 함수(edocAct, Admin SDK)만 한다.
    //  · 서버가 관리하는 필드(상태·결재선·열람 대상·결재/게시 기록 등)는 직원 화면이 만들거나 바꿀 수 없다.
    //  · 예외: edoc_leave 는 인사(HR) 화면이 관리자 계정으로 직접 기록하므로 관리자도 쓸 수 있다. edoc_overtime 은 기존 방식 유지.
    function edocProtectedKeys() {
      return ['status','approvalLine','viewerUids','approvedBy','approvedAt','submittedAt','postedAt','postedBy','lastEventAt','lineMatchesGuide','schema','recalledAt','rejectReason','applied','appliedAt','source'];
    }
    function canCreateEdocDraft() {
      return isApproved()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && !request.resource.data.keys().hasAny(['approvalLine','viewerUids','approvedBy','approvedAt','submittedAt','postedAt','postedBy','lastEventAt','lineMatchesGuide','schema','recalledAt','rejectReason','applied','appliedAt','source']);
    }
    function canEditEdocDraft() {
      return isApproved()
        && resource.data.authorUid == request.auth.uid
        && resource.data.status in ['draft','rejected']
        && request.resource.data.authorUid == resource.data.authorUid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(edocProtectedKeys());
    }

    // ── 일정 ──
    //  · 읽기: 승인된 직원 (단, 프로젝트에 속하지 않는 일정 company_schedules는 GUEST 사번 제외 — 연차·휴무는 예외로 공개)
    //  · 쓰기(등록·수정·삭제·완료 체크): GUEST 사번은 불가
    match /user_schedules/{sid}    { allow read: if isApproved(); allow write: if isApproved() && !isGuestEmp(); }
    match /ph4_schedules/{sid}     { allow read: if isApproved(); allow write: if isApproved() && !isGuestEmp(); }
    //  · company_schedules(프로젝트에 속하지 않는 모든 일정): 읽기는 GUEST 제외 — 단, 연차·휴무 사용(분류 off·leave)은 전체 공개(대표님 결정 2026-09-30)
    //    GUEST가 목록을 조회하려면 쿼리에 where('tag','in',['off','leave'])(또는 tag == 값)가 있어야 한다(규칙은 필터가 아니라 조건 증명).
    match /company_schedules/{sid} {
      allow read: if isApproved() && (!isGuestEmp() || resource.data.tag in ['off','leave']);
      allow write: if isApproved() && !isGuestEmp();
    }
    match /pjt_registry/{rid}/schedules/{sid} { allow read: if isApproved(); allow write: if isApproved() && !isGuestEmp(); }

    // portal_secrets: 직원 비밀번호(관리자 비밀번호 직접 변경 기능용, base64). 본인과 관리자만 접근.
    //  ※ 포괄 규칙(/{document=**})에서 제외되어야 한다(제외하지 않으면 승인된 직원 전원에게 다시 열린다).
    match /portal_secrets/{uid} {
      allow read, write: if isAdmin() || (isApproved() && request.auth.uid == uid);
    }

    // portal_users: 직원 계정 문서.
    //  · 읽기: 승인된 직원은 직원 목록(조직도·결재선 등)을 위해 조회 가능, 본인 문서는 로그인 승인 체크를 위해 항상 조회 가능
    //  · 쓰기: 관리자만. 단, 직원 본인은 아래 3개 필드만 수정 가능(연락처·휴대폰 인증 표시). 비밀번호는 portal_secrets에 저장한다.
    //    admin·perms·status·teamLeaderIds 등 권한 관련 필드는 관리자만 바꿀 수 있다.
    //  ※ 이 컬렉션은 아래 포괄 규칙(/{document=**})에서 제외되어야 한다 — 제외하지 않으면 포괄 규칙이 승인된 직원 전원에게 읽기·쓰기를 다시 열어 준다(OR 평가).
    match /portal_users/{uid} {
      allow read: if isApproved() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
      allow update: if isApproved() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['phone','phoneVerified','phoneVerifiedAt']);
      // (2026-10-07 제거) 예전에는 여기서 고정 관리자 이메일 한 명에게 "본인 문서가 없으면 만들 수 있는" 예외를 줬다.
      //  최초 관리자 지정이 필요하면 Firebase 콘솔(Firestore > portal_users/<uid> 에서 admin=true, status='approved')에서 직접 한다(콘솔은 규칙을 거치지 않음).
    }

    // 전자결재: 작성자·결재선·관리자만 개별 문서 열람 가능 (그 외는 목록 조회 시 자동 제외됨)
    match /edoc_daily/{docId} {
      allow read: if canViewEdocDoc();
      allow create: if canCreateEdocDraft();
      allow update: if canEditEdocDraft();
      allow delete: if false;
    }
    match /edoc_leave/{docId} {
      allow read: if canViewEdocDoc();
      allow create: if canCreateEdocDraft() || isAdmin();
      allow update: if canEditEdocDraft() || isAdmin();
      allow delete: if isAdmin();
    }
    match /edoc_resign/{docId} {
      allow read: if canViewEdocDoc();
      allow create: if canCreateEdocDraft();
      allow update: if canEditEdocDraft();
      allow delete: if false;
    }
    match /edoc_cert/{docId} {
      allow read: if canViewEdocDoc();
      allow create: if canCreateEdocDraft();
      allow update: if canEditEdocDraft();
      allow delete: if false;
    }
    match /edoc_purchase/{docId} {
      allow read: if canViewEdocDoc();
      allow create: if canCreateEdocDraft();
      allow update: if canEditEdocDraft();
      allow delete: if false;
    }
    match /edoc_expense/{docId} {
      allow read: if canViewEdocDoc();
      allow create: if canCreateEdocDraft();
      allow update: if canEditEdocDraft();
      allow delete: if false;
    }
    match /edoc_attend/{docId} {
      allow read: if canViewEdocDoc();
      allow create: if canCreateEdocDraft();
      allow update: if canEditEdocDraft();
      allow delete: if false;
    }
    match /edoc_overtime/{docId} { allow read: if canViewEdocDoc(); allow write: if isApproved(); }
    match /edoc_drive/{docId} {   // 차량 운행일지 — 다른 전자결재 문서와 같은 규칙(초안은 본인만 만들고 고침, 상신·확정은 서버 함수)
      allow read: if canViewEdocDoc();
      allow create: if canCreateEdocDraft();
      allow update: if canEditEdocDraft();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // 원격 서명 · 문서 확인 링크 (sign.html — 로그인 없이 접속, 휴대폰 문자 인증(OTP)으로 본인 확인)
    //  · sign_links/{token}        : 토큰(20자 무작위 ID)을 아는 사람만 개별 조회(get). 목록 조회·생성·삭제는 관리자만.
    //                                공개 필드는 최소한(문서 종류·이름·인증 대상 번호·만료·상태)만 둔다.
    //  · sign_links/{token}/secure : 문서 내용(주민번호 마스킹본)·회사 도장·서명 결과. 링크에 지정된 번호로 OTP 인증을 통과한 사용자만 읽기 가능.
    //                                서명 결과(result)는 1회 생성만 가능하고, 서명자는 그 외 어떤 문서도 쓸 수 없다.
    //  · 서명자(전화 인증 계정)는 이메일이 없어 isApproved()가 거짓이므로 위 링크 외의 모든 컬렉션에 접근할 수 없다.
    // ══════════════════════════════════════════════════════════════════
    function hasPhoneAuth() {
      return request.auth != null && ('phone_number' in request.auth.token);
    }
    function linkIsOpen(l) {
      return l.get('status', '') != 'revoked'
        && l.get('expiresTs', null) != null
        && request.time < l.expiresTs;
    }
    function isLinkSigner(token) {
      let l = get(/databases/$(database)/documents/sign_links/$(token)).data;
      return hasPhoneAuth()
        && l.get('phoneE164', '') != ''
        && request.auth.token.phone_number == l.phoneE164
        && linkIsOpen(l);
    }
    match /sign_links/{token} {
      allow get: if true;
      // 서명 완료 표시: 서명 결과(result) 생성과 같은 배치에서만, status/signedAt 두 필드만 변경 가능
      allow update: if hasPhoneAuth()
          && resource.data.get('phoneE164', '') != ''
          && request.auth.token.phone_number == resource.data.phoneE164
          && resource.data.status == 'pending'
          && resource.data.docType in ['labor', 'annual']
          && linkIsOpen(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signedAt'])
          && request.resource.data.status == 'signed'
          && request.resource.data.signedAt == request.time
          && existsAfter(/databases/$(database)/documents/sign_links/$(token)/secure/result);

      match /secure/{docId} {
        allow get: if isLinkSigner(token);
        allow create: if docId == 'result'
          && isLinkSigner(token)
          && get(/databases/$(database)/documents/sign_links/$(token)).data.status == 'pending'
          && get(/databases/$(database)/documents/sign_links/$(token)).data.docType in ['labor', 'annual']
          && request.resource.data.keys().hasOnly(['signData', 'signedAt', 'signedIp', 'signedUserAgent', 'remoteSigned'])
          && request.resource.data.keys().hasAll(['signData', 'signedAt', 'remoteSigned'])
          && request.resource.data.signData is string
          && request.resource.data.signData.size() < 400000
          && request.resource.data.signData.matches('data:image/png;base64,[A-Za-z0-9+/=]+')
          && request.resource.data.signedAt == request.time
          && request.resource.data.remoteSigned == true
          && request.resource.data.get('signedIp', '').size() < 64
          && request.resource.data.get('signedUserAgent', '').size() < 600;
      }
    }

    // 근로자 연명부(대표님 결정 2026-10-06): 은행·계좌번호·일당(단가)과 통장사본만 관리자 전용, 나머지(주민번호·전화·건강검진·자격·교육·상생협력포탈 계정·비고·주소·사진·신분증·이수증)는 실무자(PJT 권한자)가 등록·조회·수정.
    //  · master_worker_private = 관리자 전용(은행·계좌·일당·팀 단가) · master_worker_info = 실무자(삭제는 관리자) · master_worker_photos = 실무자(문서 번호가 __bank 로 끝나는 통장사본만 관리자)
    match /master_worker_private/{wid} { allow read, write: if isAdmin(); }
    // 주민(외국인)등록번호(2026-10-07, 설계서 §50): 전체 번호는 서버 전용 저장소 worker_identity 에 암호문으로만 있다. 클라이언트는 이 문서에 jumin(평문)·juminMasked(마스킹 값)·juminUpdatedAt 을 쓰지 못한다(서버 함수만 씀).
    match /master_worker_info/{wid} {
      allow read: if isRosterUser();
      allow create: if isRosterUser() && !request.resource.data.keys().hasAny(['jumin','juminMasked','juminUpdatedAt']);
      allow update: if isRosterUser() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['jumin','juminMasked','juminUpdatedAt']);
      allow delete: if isAdmin();
    }
    //  · worker_identity(암호문)·access_counters(열람 한도 계산) = 클라이언트 읽기·쓰기 전부 금지(서버만)
    //  · access_log(열람 기록)·access_log_checks(월 점검 표시) = 관리자 읽기만, 쓰기·삭제는 아무도 못 함(서버만 씀, 보관 3년)
    // 재무회계 원장(2026-10-08): 전표·마감·설정·감사·가져오기 이력은 재무회계 권한자가 읽기만, 쓰기·수정·삭제는 아무도 못 함(서버 함수 ledgerAct 만 씀)
    match /ledger_entries/{id} { allow read: if isFinanceUser(); allow write: if false; }
    match /ledger_meta/{id} { allow read: if isFinanceUser(); allow write: if false; }
    match /ledger_audit/{id} { allow read: if isFinanceUser(); allow write: if false; }
    match /ledger_imports/{id} { allow read: if isFinanceUser(); allow write: if false; }
    match /ledger_receipts/{id} { allow read, write: if false; }   // 영수증 읽기 기록·원본 경로 — 서버 함수(ledgerReceipt)만 다루고 화면은 직접 읽지 못한다(원본은 서버가 대신 내려줌)
    // 전표 초안을 만들 원천(비용 장부·정산서)은 재무회계 권한자도 읽을 수 있다(쓰기는 기존대로 관리자만)
    match /gihoek_expenses/{id} { allow read: if isFinanceUser(); }
    match /gihoek_settlements/{id} { allow read: if isFinanceUser(); }
    match /worker_identity/{id} { allow read, write: if false; }
    match /access_counters/{id} { allow read, write: if false; }
    match /access_log/{id} { allow read: if isAdmin(); allow write: if false; }
    match /access_log_checks/{id} { allow read: if isAdmin(); allow write: if false; }
    match /master_worker_photos/{wid} {
      allow read, delete: if isAdmin() || (isRosterUser() && !wid.matches('.*__bank$'));
      allow create, update: if (isAdmin() || (isRosterUser() && !wid.matches('.*__bank$'))) && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() < 1000000 && request.resource.data.dataUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+');
    }
    // 팀 단가 — 관리자 또는 그 팀의 팀장(portal_users.teamLeaderIds에 팀장 ID가 지정된 계정, 관리자만 지정 가능)만 조회.
    // 다른 팀의 단가는 조회할 수 없다. 개별 문서 조회(get)만 가능하며 컬렉션 전체 목록 조회는 관리자만.
    match /team_rates/{leaderId} {
      allow read: if isAdmin()
        || (isApproved()
            && leaderId in get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data.get('teamLeaderIds', []));
      allow write: if isAdmin();
    }

    // evaluations 는 하위 컬렉션마다 아래 전용 조항이 맡는다(넓은 인사 데이터 조항에서 컬렉션째 제외).
    //  조항이 겹치면 하나라도 허용 시 허용이라서, 넓은 조항에 evaluations 가 남아 있으면 관리자 계정 누구나 점수·동료 평균(peerAgg)·확정을 직접 쓸 수 있다.
    match /{hrCol}/{document=**} {
      allow read, write: if isHrDataCollection() && isAdmin() && hrCol != 'evaluations';
    }
    // 개별 평가 기록(인사 → 개별 기록 화면): 기존과 같음 — 관리자가 읽기·추가·수정·삭제
    match /evaluations/{wid}/records/{rid} {
      allow read, write: if isAdmin();
    }
    // 평가 점수 문서: 읽기는 관리자(기존과 같음), 쓰기는 사장단 3명의 계정만, 동료 평균(peerAgg)은 어떤 계정도 쓸 수 없다(서버 함수만 씀 — 관리자 SDK 는 규칙을 거치지 않는다).
    //  · merge 저장도 "저장 뒤 문서"와 "기존 문서"를 비교하므로, 기존 peerAgg 를 그대로 둔 채 다른 필드만 바꾸는 저장은 통과한다.
    //  · 삭제는 누구도 못 한다(점수 기록을 지워 평가를 되돌리는 것 방지).
    function peerAggUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['peerAgg']);
    }
    match /evaluations/{wid}/cycles/{year} {
      allow read: if isAdmin();
      allow create: if isCycleManager() && !('peerAgg' in request.resource.data);
      allow update: if isCycleManager() && peerAggUntouched();
      allow delete: if false;
    }
    match /evaluations/{wid}/adhoc/{pid} {
      allow read: if isAdmin();
      allow create, update: if isCycleManager();
      allow delete: if false;
    }
    match /payslips/{wid}/{document=**} {
      allow read: if hasPlanPerm();
    }

    // 채용 공고 — 게시 중(open) 공고만 비로그인(홈페이지)도 조회, 등록·수정·삭제·전체조회는 관리자만
    match /job_postings/{jobId} {
      allow get, list: if resource.data.status == 'open' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /recruit_applicants/{applicantId} {
      allow create: if validApplicantCreate();
    }

    // 인사 캘린더 — 지정 담당자(hr_calendar_access/config.emails)만 조회·등록·수정·삭제. 접근자 목록 자체도 담당자만 읽고 고칠 수 있다.
    match /hr_calendar_access/{docId} {
      allow read, write: if isHrCalendarUser();
    }
    match /hr_calendar_events/{eventId} {
      allow read, delete: if isHrCalendarUser();
      allow create, update: if isHrCalendarUser() && validHrEvent();
    }

    // 근로자 민감 정보(주민번호·계좌·주소·서명): 관리자 또는 본인(portalUid)만 읽기, 쓰기는 관리자만.
    //  · workers 에는 이름·직급·부서 등 일반 정보만 둔다(전자결재·PJT·기획·모바일이 일반 정보를 읽기 때문).
    //  주민번호는 여기에 평문으로 쓰지 않는다 — 서버 함수(identityAct)가 암호문으로 worker_identity 에 저장하고 마스킹 값(juminMasked)만 이 문서에 쓴다(설계서 §50).
    match /worker_private/{wid} {
      allow read: if isAdmin() || (isApproved() && resource.data.get('portalUid', '') == request.auth.uid);
      allow create: if isAdmin() && !request.resource.data.keys().hasAny(['jumin','juminMasked','juminUpdatedAt']);
      allow update: if isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['jumin','juminMasked','juminUpdatedAt']);
      allow delete: if isAdmin();
    }

    // 기획(gihoek_*): 관리자만 읽기·쓰기(견적·경비·정산·거래처 등).
    //  예외 gihoek_projects — 전자결재 업무일지(진행 중 프로젝트 목록)와 경량PJT 가 코드·이름·현장·발주처 같은 기본정보(금액 없음)를 읽으므로 승인된 계정은 읽기만 허용.
    //  쓰기(생성·수정·삭제)는 관리자만 — 프로젝트 정보 수정은 관리자 계정만 한다(경량PJT '프로젝트 수정' 동기화도 관리자 계정으로만 반영됨).
    match /{gcol}/{document=**} {
      allow read, write: if gcol.matches('gihoek_.*') && isAdmin();
    }
    match /gihoek_projects/{pid} {
      allow read: if isApproved();
    }

    // 근로자 명부(workers): 읽기는 승인된 계정(전자결재·PJT·기획·모바일이 이름·직급·부서·입사일을 조회), 쓰기는 관리자만.
    //  · 인사 모듈·포털 계정 관리(관리자 작업)만 workers 를 쓴다 — 일반 직원이 다른 직원의 직급·부서·호봉을 바꿀 수 없게 한다.
    //  · 하위 문서(workers/{id}/history 등)는 관리자만 읽고 쓴다.
    match /workers/{wid} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
    match /workers/{wid}/{document=**} {
      allow read, write: if isAdmin();
    }

    // 근태 기록(worker_attendance_log/{근로자ID}_{날짜}): 관리자 또는 본인 기록만 읽기·쓰기.
    //  · 본인 판정은 workers.portalUid(인사에서 계정 연동). 연동 안 된 계정은 출퇴근 기록을 못 한다(인사 담당자에게 근무자 연동 요청).
    //  · 생성 시 문서 ID 는 workerId_date 이어야 하고, 수정 시 workerId·date 는 바꿀 수 없다. 삭제는 관리자만.
    match /worker_attendance_log/{logId} {
      allow read: if isAdmin() || isAttOwner(resource.data.workerId);
      allow create: if isAdmin() || (isAttOwner(request.resource.data.workerId)
        && request.resource.data.date is string
        && logId == request.resource.data.workerId + '_' + request.resource.data.date);
      allow update: if isAdmin() || (isAttOwner(resource.data.workerId)
        && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.date == resource.data.date);
      allow delete: if isAdmin();
    }

    // PJT 본체(pjt_registry/{id}): 생성·삭제·정보 수정은 관리자만. 일반 직원은 운영 값 progress·manday 두 항목만 수정(공정 체크·공수 입력 시 자동 계산).
    //  하위 데이터(items·workers·attendance·manday·schedules·reports 등)는 승인 직원이 지금처럼 읽고 쓴다.
    match /pjt_registry/{id} {
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isApproved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress','manday']));
    }
    match /pjt_registry/{id}/{sub}/{docId}/{rest=**} {
      allow write: if isApproved() && sub != 'schedules';   // schedules 는 위의 GUEST 제한 규칙(pjt_registry/{rid}/schedules/{sid})이 따로 담당 — 여기서 열면 OR 평가로 GUEST 쓰기가 다시 열린다
    }

    // PJT 설정(pjt_settings/{p4ph2|p4ph4}): 프로젝트 정보 수정은 관리자 계정만(읽기는 승인 직원 — 홈 기본정보·헤더·종료 PJT 구분에 사용).
    match /pjt_settings/{key}/{document=**} {
      allow write: if isAdmin();
    }

    // 그 외 모든 컬렉션(현재+향후 전부, edoc_*·관리자 전용 제외): 승인된 @jhsol.kr 계정만 읽기/쓰기
// ─────────────────────────────────────────────────────────────────────────────
// 평가("내 평가") 전용 보안 규칙 블록 — 2026-10-15 (docs/hr-evaluation-design.md 9-1절)
// ※ 이 파일은 "전체 규칙"이 아니라 평가 전용 규칙 블록입니다. **단독으로 붙이면 안 됩니다.**
//    기존 규칙 맨 아래의 `match /{document=**}`(승인된 직원이면 읽기·쓰기 허용)가 이 블록과 OR 로 합쳐져 평가 보호가 모두 사라집니다(에뮬레이터로 확인).
//    그래서 ① isEvalCollection() 함수를 추가하고 ② 그 맨 아래 규칙의 read·write 조건에 `&& !isEvalCollection()` 을 더하고 ③ 이 블록을 그 규칙 앞에 넣어야 합니다.
//    검증된 전체 파일: docs/rules/firestore.rules_테섭_평가추가본_2026-10-15.rules (2026-10-13 테섭 백업 기준), 절차: docs/rules/배포_절차_평가.md
// 필요한 기존 함수: isApproved(), isAdmin()  — 이미 게시된 규칙에 있음.
// 원칙: ① 직원은 본인에게 배정된 과제만 쓰고 본인 제출분만 읽는다 ② 동료평가(peer) 원점수는 관리자도 읽지 못한다(서버 함수만)
//       ③ 열린 평가 기간에만 쓴다 ④ 제출하면 수정·삭제할 수 없다 ⑤ 모르는 필드·잘못된 값은 거부한다
// ─────────────────────────────────────────────────────────────────────────────

    // 평가 회차(열림/닫힘/공개): 승인된 직원이 읽고(내 평가 화면이 열렸는지 확인), 관리자만 쓴다
    // 평가 회차를 만들고 단계를 바꾸는 권한은 **사장단 3명(송지훈·김종화·김영희)의 계정**으로만 한정한다 — 관리자 계정 누구나가 아니라(인사팀 관리자가 화면을 우회해 평가를 마감하는 것을 막음).
    // 직급은 직원 관리에서 바뀌는 값이라 쓰지 않고, 바뀌지 않는 계정 식별자(uid)를 쓴다. 목록을 바꾸려면 이 규칙을 다시 게시해야 한다(관리자 화면으로는 못 바꾼다).
    // 화면(app/shared/eval-perm.js CYCLE_MANAGERS)·서버(functions/eval-act.js CYCLE_MANAGERS)와 같은 목록이어야 하며 시험(tests/eval-managers.test.mjs)이 대조한다.
    function isCycleManager() {
      return isAdmin() && request.auth.uid in [
        '202TPNudKZghsTPAeeG206f8vbJ3',   // 송지훈 (대표)
        '8KuOuhqirGWmrYKw8eOCPnqtYBr2',   // 김종화 (부사장)
        'muButMmunGX91id0HmHZVBMDq6B3'    // 김영희 (부사장)
      ];
    }
    // 상태는 draft(준비) → open(진행) → closed(마감) → published(공개) 순으로만 나아간다. **마감(closed)·공개(published)된 회차는 다시 열 수 없다**:
    // 다시 열어 제출을 받은 뒤 또 집계하면 평균 변화로 새 제출자의 점수를 역산할 수 있기 때문이다(서버 함수 aggregatePeers 가 마감 후에만 집계하는 이유와 같다).
    match /eval_cycles/{cycleId} {
      function rank(st) { return st == 'draft' ? 0 : st == 'open' ? 1 : st == 'closed' ? 2 : st == 'published' ? 3 : -1; }
      allow read: if isApproved();
      allow create: if isCycleManager() && request.resource.data.keys().hasOnly(['status', 'year', 'updatedAt', 'updatedBy']) && request.resource.data.status in ['draft', 'open'];
      allow update: if isCycleManager() && request.resource.data.keys().hasOnly(['status', 'year', 'updatedAt', 'updatedBy'])
        && rank(request.resource.data.status) >= rank(resource.data.get('status', 'draft'))
        && !(resource.data.get('status', 'draft') in ['closed', 'published'] && request.resource.data.status in ['draft', 'open']);
      allow delete: if false;
    }

    // 직원별 평가 과제 목록(누가 누구를 평가해야 하는가): 본인과 관리자가 읽고, 관리자만 만든다·고친다
    // 문서 id = {연도}__{본인 uid}  (예: 2026__AbC123)
    match /eval_tasks/{taskId} {
      allow read: if isApproved() && (isAdmin() || taskId.matches('^[0-9]{4}__' + request.auth.uid + '$'));
      allow write: if isAdmin();
    }

    // 평가 제출: 문서 id = {연도}__{평가자 uid}__{대상 근로자 id}__{종류}   종류 = self | peer | lead
    match /eval_submissions/{subId} {
      function parts() { return subId.split('__'); }
      function cycleOpen(year) {
        return exists(/databases/$(database)/documents/eval_cycles/$(year))
          && get(/databases/$(database)/documents/eval_cycles/$(year)).data.get('status', '') == 'open';
      }
      // 이 평가자에게 이 과제(대상·종류)가 배정되어 있는가
      function assigned(year, kind, target) {
        let t = get(/databases/$(database)/documents/eval_tasks/$(year + '__' + request.auth.uid));
        return exists(/databases/$(database)/documents/eval_tasks/$(year + '__' + request.auth.uid))
          && (year + '__' + kind + '__' + target) in t.data.get('keys', []);
      }
      function ownDoc() { return parts().size() == 4 && parts()[1] == request.auth.uid; }
      function validBody(kind) {
        let d = request.resource.data;
        return d.keys().hasOnly(['year', 'raterUid', 'targetWid', 'kind', 'scores', 'text', 'status', 'updatedAt', 'submittedAt'])
          && d.keys().hasAll(['year', 'raterUid', 'targetWid', 'kind', 'scores', 'status'])
          && d.raterUid == request.auth.uid
          && d.year == int(parts()[0]) && d.targetWid == parts()[2] && d.kind == parts()[3] && d.kind == kind
          && d.scores is map && d.scores.size() <= 8
          && d.get('text', '') is string && d.get('text', '').size() <= 2000
          && d.status in ['draft', 'submitted'];
      }

      // 읽기: 작성자 본인. 관리자는 "동료평가(peer)가 아닌" 제출만(자기평가·팀장 1차 평가는 면담·확정에 쓰임).
      // 동료평가 원점수는 서버 함수(관리자 SDK)만 읽어 평균을 낸다 — 누구에게도 보이지 않는다.
      // ※ 본인 판정은 문서 id 가 아니라 문서 안의 raterUid 필드로 한다 — 목록 조회(where raterUid == 내 uid)가 규칙을 통과하려면 필드 기준이어야 한다.
      //    문서 id 와 raterUid 가 어긋난 문서는 만들 수 없다(create/update 의 validBody 가 id 의 평가자 = raterUid = 로그인한 사람을 강제한다).
      allow read: if isApproved() && resource.data.raterUid == request.auth.uid
        || isAdmin() && resource.data.kind in ['self', 'lead'];

      // 만들기: 본인 문서, 열린 기간, 배정된 과제, 형식이 맞을 때
      allow create: if isApproved() && ownDoc()
        && parts()[3] in ['self', 'peer', 'lead']
        && cycleOpen(parts()[0])
        && assigned(parts()[0], parts()[3], parts()[2])
        && validBody(parts()[3])
        && request.resource.data.status in ['draft', 'submitted'];

      // 고치기: 본인·열린 기간·아직 제출 전(draft)인 것만. 제출(submitted)한 문서는 다시 못 고친다.
      allow update: if isApproved() && ownDoc()
        && cycleOpen(parts()[0])
        && resource.data.status == 'draft'
        && validBody(parts()[3])
        && request.resource.data.raterUid == resource.data.raterUid
        && request.resource.data.targetWid == resource.data.targetWid
        && request.resource.data.kind == resource.data.kind;

      // 지우기: 아무도 못 한다(제출 기록 보존). 서버 함수(관리자 SDK)만 정리할 수 있다.
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if isApproved() && !isEdocCollection() && !isAdminOnlyCollection() && !isEvalCollection();
      allow write: if isApproved() && !isEdocCollection() && !isAdminOnlyCollection() && !isAdminWriteCollection() && !isEvalCollection();
    }
  }
}