// ─────────────────────────────────────────────────────────────────────────────
// 평가("내 평가") 전용 보안 규칙 블록 — 2026-10-15 (docs/hr-evaluation-design.md 9-1절)
// ※ 이 파일은 "전체 규칙"이 아니라 평가 전용 규칙 블록입니다. **단독으로 붙이면 안 됩니다.**
//    기존 규칙 맨 아래의 `match /{document=**}`(승인된 직원이면 읽기·쓰기 허용)가 이 블록과 OR 로 합쳐져 평가 보호가 모두 사라집니다(에뮬레이터로 확인).
//    그래서 ① isEvalCollection() 함수를 추가하고 ② 그 맨 아래 규칙의 read·write 조건에 `&& !isEvalCollection()` 을 더하고 ③ 이 블록을 그 규칙 앞에 넣어야 합니다.
//    검증된 전체 파일: docs/rules/firestore.rules_테섭_평가추가본_2026-10-15.rules (2026-10-13 테섭 백업 기준), 절차: docs/rules/배포_절차_평가.md
// 필요한 기존 함수: isApproved(), isAdmin()  — 이미 게시된 규칙에 있음.
// 원칙: ① 직원은 본인에게 배정된 과제만 쓰고 본인 제출분만 읽는다 ② 동료평가(peer) 원점수는 관리자도 읽지 못한다(서버 함수만)
//       ③ 열린 평가 기간에만 쓴다 ④ 제출하면 수정·삭제할 수 없다 ⑤ 모르는 필드·잘못된 값은 거부한다
// ─────────────────────────────────────────────────────────────────────────────

    // 평가 회차(열림/닫힘/공개): 승인된 직원이 읽고(내 평가 화면이 열렸는지 확인), 관리자만 쓴다
    // 상태는 draft(준비) → open(진행) → closed(마감) → published(공개) 순으로만 나아간다. **마감(closed)·공개(published)된 회차는 다시 열 수 없다**:
    // 다시 열어 제출을 받은 뒤 또 집계하면 평균 변화로 새 제출자의 점수를 역산할 수 있기 때문이다(서버 함수 aggregatePeers 가 마감 후에만 집계하는 이유와 같다).
    match /eval_cycles/{cycleId} {
      function rank(st) { return st == 'draft' ? 0 : st == 'open' ? 1 : st == 'closed' ? 2 : st == 'published' ? 3 : -1; }
      allow read: if isApproved();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['status', 'year', 'updatedAt', 'updatedBy']) && request.resource.data.status in ['draft', 'open'];
      allow update: if isAdmin() && request.resource.data.keys().hasOnly(['status', 'year', 'updatedAt', 'updatedBy'])
        && rank(request.resource.data.status) >= rank(resource.data.get('status', 'draft'))
        && !(resource.data.get('status', 'draft') in ['closed', 'published'] && request.resource.data.status in ['draft', 'open']);
      allow delete: if false;
    }

    // 직원별 평가 과제 목록(누가 누구를 평가해야 하는가): 본인과 관리자가 읽고, 관리자만 만든다·고친다
    // 문서 id = {연도}__{본인 uid}  (예: 2026__AbC123)
    match /eval_tasks/{taskId} {
      allow read: if isApproved() && (isAdmin() || taskId.matches('^[0-9]{4}__' + request.auth.uid + '$'));
      allow write: if isAdmin();
    }

    // 평가 제출: 문서 id = {연도}__{평가자 uid}__{대상 근로자 id}__{종류}   종류 = self | peer | lead
    match /eval_submissions/{subId} {
      function parts() { return subId.split('__'); }
      function cycleOpen(year) {
        return exists(/databases/$(database)/documents/eval_cycles/$(year))
          && get(/databases/$(database)/documents/eval_cycles/$(year)).data.get('status', '') == 'open';
      }
      // 이 평가자에게 이 과제(대상·종류)가 배정되어 있는가
      function assigned(year, kind, target) {
        let t = get(/databases/$(database)/documents/eval_tasks/$(year + '__' + request.auth.uid));
        return exists(/databases/$(database)/documents/eval_tasks/$(year + '__' + request.auth.uid))
          && (year + '__' + kind + '__' + target) in t.data.get('keys', []);
      }
      function ownDoc() { return parts().size() == 4 && parts()[1] == request.auth.uid; }
      function validBody(kind) {
        let d = request.resource.data;
        return d.keys().hasOnly(['year', 'raterUid', 'targetWid', 'kind', 'scores', 'text', 'status', 'updatedAt', 'submittedAt'])
          && d.keys().hasAll(['year', 'raterUid', 'targetWid', 'kind', 'scores', 'status'])
          && d.raterUid == request.auth.uid
          && d.year == int(parts()[0]) && d.targetWid == parts()[2] && d.kind == parts()[3] && d.kind == kind
          && d.scores is map && d.scores.size() <= 8
          && d.get('text', '') is string && d.get('text', '').size() <= 2000
          && d.status in ['draft', 'submitted'];
      }

      // 읽기: 작성자 본인. 관리자는 "동료평가(peer)가 아닌" 제출만(자기평가·팀장 1차 평가는 면담·확정에 쓰임).
      // 동료평가 원점수는 서버 함수(관리자 SDK)만 읽어 평균을 낸다 — 누구에게도 보이지 않는다.
      // ※ 본인 판정은 문서 id 가 아니라 문서 안의 raterUid 필드로 한다 — 목록 조회(where raterUid == 내 uid)가 규칙을 통과하려면 필드 기준이어야 한다.
      //    문서 id 와 raterUid 가 어긋난 문서는 만들 수 없다(create/update 의 validBody 가 id 의 평가자 = raterUid = 로그인한 사람을 강제한다).
      allow read: if isApproved() && resource.data.raterUid == request.auth.uid
        || isAdmin() && resource.data.kind in ['self', 'lead'];

      // 만들기: 본인 문서, 열린 기간, 배정된 과제, 형식이 맞을 때
      allow create: if isApproved() && ownDoc()
        && parts()[3] in ['self', 'peer', 'lead']
        && cycleOpen(parts()[0])
        && assigned(parts()[0], parts()[3], parts()[2])
        && validBody(parts()[3])
        && request.resource.data.status in ['draft', 'submitted'];

      // 고치기: 본인·열린 기간·아직 제출 전(draft)인 것만. 제출(submitted)한 문서는 다시 못 고친다.
      allow update: if isApproved() && ownDoc()
        && cycleOpen(parts()[0])
        && resource.data.status == 'draft'
        && validBody(parts()[3])
        && request.resource.data.raterUid == resource.data.raterUid
        && request.resource.data.targetWid == resource.data.targetWid
        && request.resource.data.kind == resource.data.kind;

      // 지우기: 아무도 못 한다(제출 기록 보존). 서버 함수(관리자 SDK)만 정리할 수 있다.
      allow delete: if false;
    }
